# 공개 배포용 비밀값 예시. 실제 값은 secrets.toml(깃에 올리지 않음) 또는 호스팅 서비스의 Secrets 화면에만 넣는다.
# 최상위 키는 환경변수로도 노출되므로 코드는 os.getenv로 그대로 읽는다.
ANTHROPIC_API_KEY = "여기에-새로-발급한-키"
PREFLIGHT_MODE = "public"            # 작업 공간 코드로 사용자별 기록 격리
PREFLIGHT_DAILY_LIMIT = "30"         # 작업 공간당 하루 AI 검수 상한
PREFLIGHT_GLOBAL_DAILY_LIMIT = "300" # 서비스 전체 하루 AI 검수 상한 (예상 비용 상한)
